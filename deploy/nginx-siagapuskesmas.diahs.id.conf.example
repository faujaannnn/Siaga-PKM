# Domain: siagapuskesmas.diahs.id
# Satu stack: nginx melayani build Vite (root) + mem-proxy /api ke uvicorn (127.0.0.1:37841).
#
# HTTP-only bootstrap: bash scripts/sync-nginx.sh (lalu certbot).
# Setelah certbot, file ini sudah berisi blok :443 — sync-nginx TIDAK menimpa jika SSL ada.
#
# Deploy penuh: bash scripts/kopas-deploy-siagapuskesmas-diahs.sh

# =============================================================================
# HTTPS — SPA + API (blok utama setelah certbot)
# =============================================================================
server {
    server_name siagapuskesmas.diahs.id www.siagapuskesmas.diahs.id;

    client_max_body_size 200m;

    include /etc/nginx/snippets/security-headers-siaga.conf;

    root /var/www/siagapuskesmas;
    index index.html;

    location / {
        try_files $uri $uri/ /index.html;
    }

    location ^~ /assets/ {
        expires 30d;
        add_header Cache-Control "public, immutable" always;
        include /etc/nginx/snippets/security-headers-siaga.conf;
    }

    location = /api/whatsapp/webhook {
        proxy_pass http://127.0.0.1:37841;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Authorization $http_authorization;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
        send_timeout 300s;
    }

    location = /api/webhooks/fonnte {
        proxy_pass http://127.0.0.1:37841;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Authorization $http_authorization;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
        send_timeout 300s;
    }

    location /api {
        proxy_pass http://127.0.0.1:37841;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Authorization $http_authorization;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
        send_timeout 300s;
    }

    listen [::]:443 ssl; # managed by Certbot
    listen 443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/siagapuskesmas.diahs.id/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/siagapuskesmas.diahs.id/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot
}

# =============================================================================
# HTTP → HTTPS (certbot)
# =============================================================================
server {
    if ($host = siagapuskesmas.diahs.id) {
        return 301 https://$host$request_uri;
    } # managed by Certbot

    listen 80;
    listen [::]:80;
    server_name siagapuskesmas.diahs.id;
    return 404; # managed by Certbot
}

# Salin ke .env dan sesuaikan. Lihat INTEGRASI_WA_SIAGA_PUSKESMAS_MAGIC_LINK.txt di folder app (induk repo).

MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=siaga_puskesmas
JWT_SECRET=ganti-secret-di-produksi-minimal-32-karakter

# URL publik API (tanpa /api) — webhook Fonnte & reverse proxy
PUBLIC_API_BASE=https://siagapuskesmas.diahs.id

# WhatsApp via Fonnte — nomor chat resmi (62…), terpisah dari Siaga Bencana
# Webhook: https://siagapuskesmas.diahs.id/api/whatsapp/webhook
WA_GATEWAY=fonnte
FONNTE_TOKEN=
FONNTE_INBOUND_WA=6282190259990
FONNTE_API_BASE=https://api.fonnte.com
# Cadangan Evolution
# WA_GATEWAY=evolution
EVOLUTION_API_BASE=http://127.0.0.1:18790
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=siaga puskesmas
EVOLUTION_INBOUND_WA=
WA_MAGIC_LINK_TTL_MINUTES=30

# Asisten WA petugas (Fonnte): tanya materi / progres ML (DeepSeek atau Ollama — sama seperti Video ML)
FONNTE_STAFF_AI_ENABLED=true
# Ukuran korpus (edukasi + naskah video ML + halaman + beranda); naikkan bila perlu
FONNTE_STAFF_CONTEXT_MAX_CHARS=100000
FONNTE_STAFF_LLM_READ_TIMEOUT=36
FONNTE_STAFF_LLM_MAX_TOKENS=600
# 0–0.15: lebih literal, kurang “kreatif”
FONNTE_STAFF_LLM_TEMPERATURE=0.05
# 0 = tidak membatasi kecepatan chat; naikkan jika webhook terduplikat
FONNTE_STAFF_RATE_MIN_SECONDS=0
# LLM_PROVIDER=deepseek
# DEEPSEEK_API_KEY=
# Opsional: unduhan PDF ML dari Drive via API resmi (aktifkan Google Drive API + kunci di GCP)
# GOOGLE_DRIVE_API_KEY=

# Jalur WhatsApp aktif: fonnte. Webhook: https://siagapuskesmas.diahs.id/api/whatsapp/webhook
# Cadangan: WA_GATEWAY=evolution — webhook Evolution di …/api/webhooks/evolution
# EVOLUTION_API_BASE=http://127.0.0.1:18790
# EVOLUTION_API_KEY=
# Nama instance Evolution (bukan nomor HP)
# EVOLUTION_INSTANCE=siaga puskesmas
# Nomor bisnis untuk link wa.me (62…)
# EVOLUTION_INBOUND_WA=6281140011660
#
# --- Port (bukan dibaca app.py; dokumentasi operasional) ---
# API uvicorn utama: default 37841 — set `SBP_UVICORN_PORT` lalu `bash scripts/pm2-backend.sh`.
# MongoDB: MONGODB_URI di atas (default :27017), tidak berubah saat port API diganti.
